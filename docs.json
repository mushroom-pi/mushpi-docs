{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Mushroom Pi",
  "theme": "palm",
  "colors": {
    "primary": "#2F7349",
    "light": "#C66F2F",
    "dark": "#C66F2F"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "dark": "#0f1720"
    },
    "decoration": "gradient"
  },
  "fonts": {
    "family": "Inter"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "system-overview"
            ]
          },
          {
            "group": "Build & Self-Host",
            "pages": [
              {
                "group": "Setting a Pico unit up",
                "pages": [
                  "pico-units/firmware",
                  "pico-units/components",
                  "pico-units/wiring",
                  "pico-units/power"
                ]
              },
              {
                "group": "Hub dashboard",
                "pages": [
                  "deployment/sd-card-provisioning",
                  "deployment/self-hosting",
                  "deployment/environment",
                  "deployment/first-boot",
                  "deployment/pico-registration",
                  "deployment/updates-and-backups",
                  "deployment/host-wifi-recovery"
                ]
              }
            ]
          },
          {
            "group": "Using Mushroom Pi",
            "pages": [
              {
                "group": "Using a Pico unit",
                "pages": [
                  "pico-units/index",
                  "pico-units/unit-page",
                  "pico-units/offline-operation",
                  "pico-units/status-indicators"
                ]
              },
              {
                "group": "Hub dashboard",
                "pages": [
                  "dashboard/index",
                  "dashboard/pico-units",
                  "dashboard/recipes",
                  "dashboard/batches",
                  "dashboard/monitoring",
                  "dashboard/finishing-a-batch",
                  "dashboard/server",
                  "dashboard/settings",
                  "dashboard/troubleshooting"
                ]
              }
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/hysteresis-control",
              "configuration/remote-access"
            ]
          },
          {
            "group": "Contributing",
            "pages": [
              {
                "group": "Architecture",
                "pages": [
                  "architecture/c4-context",
                  "architecture/c4-container",
                  "architecture/c4-component-server",
                  "architecture/c4-component-grow",
                  "architecture/c4-component-client",
                  "architecture/release-pipeline"
                ]
              },
              {
                "group": "Development",
                "pages": [
                  "development/mock-pico",
                  "development/contributing"
                ]
              }
            ]
          },
          {
            "group": "License",
            "pages": [
              "license"
            ]
          },
          {
            "group": "Releases",
            "pages": [
              "releases"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview"
            ]
          },
          {
            "group": "Mushpi Server API",
            "openapi": {
              "source": "https://raw.githubusercontent.com/mushroom-pi/mushpi-server/dev/spec/openapi.json",
              "overlays": [
                "overlays/server-authentication.yaml"
              ]
            }
          },
          {
            "group": "Pico REST API",
            "openapi": {
              "source": "https://raw.githubusercontent.com/mushroom-pi/mushpi-grow/dev/spec/openapi.yaml"
            }
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/configuration/environment",
      "destination": "/deployment/environment"
    },
    {
      "source": "/api/authentication",
      "destination": "/api/overview"
    },
    {
      "source": "/api/units",
      "destination": "/api/overview"
    },
    {
      "source": "/api/readings",
      "destination": "/api/overview"
    },
    {
      "source": "/api/batches",
      "destination": "/api/overview"
    },
    {
      "source": "/api/recipes",
      "destination": "/api/overview"
    },
    {
      "source": "/api/settings",
      "destination": "/api/overview"
    },
    {
      "source": "/api/pico/overview",
      "destination": "/api/overview"
    },
    {
      "source": "/api/pico/endpoints",
      "destination": "/api/overview"
    },
    {
      "source": "/hardware/components",
      "destination": "/pico-units/components"
    },
    {
      "source": "/hardware/wiring",
      "destination": "/pico-units/wiring"
    },
    {
      "source": "/hardware/power",
      "destination": "/pico-units/power"
    },
    {
      "source": "/hardware/pico-firmware",
      "destination": "/pico-units/firmware"
    },
    {
      "source": "/hardware/provisioning",
      "destination": "/pico-units/offline-operation"
    },
    {
      "source": "/hardware/unit-page",
      "destination": "/pico-units/unit-page"
    },
    {
      "source": "/hardware/status-indicators",
      "destination": "/pico-units/status-indicators"
    }
  ],
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/mushroom-pi"
    }
  }
}
